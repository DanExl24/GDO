# ==========================================
# ETAPA 1: Construcción (Builder)
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

# Instalar dependencias
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copiar archivos fuente del frontend
COPY quasar.config.ts tsconfig.json index.html ./
COPY public ./public
COPY src ./src

# Argumento para la URL de la API en producción
ARG API_URL
ENV API_URL=$API_URL

# Compilar SPA con Quasar
RUN npx quasar build

# ==========================================
# ETAPA 2: Servidor Nginx en Producción
# ==========================================
FROM nginx:alpine

# Copiar configuración personalizada de Nginx para SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar compilado de Quasar
COPY --from=builder /app/dist/spa /usr/share/nginx/html

# Puerto frontend: 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
