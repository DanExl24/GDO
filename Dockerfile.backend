# ==========================================
# ETAPA 1: Construcción y Producción Backend
# ==========================================
FROM node:24-alpine

WORKDIR /app

# Copiar dependencias e instalarlas
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copiar código fuente y configuración de TypeScript
COPY tsconfig.json ./
COPY server ./server

# Compilar TypeScript del servidor (genera server/dist)
RUN npm run build:server

# Eliminar dependencias de desarrollo para aligerar la imagen
RUN npm prune --production --legacy-peer-deps

# Puerto backend: 3000
EXPOSE 3000
ENV PORT=3000

CMD ["npm", "run", "start:server"]
