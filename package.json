{
  "name": "sistema-offline-online",
  "version": "1.0.0",
  "description": "Sistema CRUD Offline-Online con sincronización automática",
  "productName": "OfflineOnline",
  "author": "alejo",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "dev:android": "quasar dev -m capacitor -T android",
    "build:android": "quasar build -m capacitor -T android",
    "server": "npx ts-node server/index.ts",
    "init-db": "npx ts-node server/init-db.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node server/dist/index.js"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/network": "^6.0.0",
    "@capgo/capacitor-updater": "^8.51.2",
    "@quasar/extras": "^1.16.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "pinia": "^2.1.0",
    "quasar": "^2.17.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0",
    "vue-tsc": "^2.0.0"
  }
